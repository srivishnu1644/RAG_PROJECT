# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed origins for CORS.
CORS_ORIGIN=http://localhost:5173

# ─── Database (MongoDB Atlas) ──────────────────────────────────────────────
# Paste the SRV string from Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=rag_app

# ─── Auth ──────────────────────────────────────────────────────────────────
# Use a long random string in production: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Embeddings ────────────────────────────────────────────────────────────
# local = free, runs in-process (default). gemini = uses GEMINI_API_KEY.
EMBEDDING_PROVIDER=local

# MUST match the Atlas index numDimensions exactly.
# 384 for local MiniLM (all-MiniLM-L6-v2). Do not change without re-indexing.
EMBEDDING_DIMENSIONS=384

# Hugging Face model id. Only used when EMBEDDING_PROVIDER=local.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Where the ONNX model is cached. Keep this OUTSIDE node_modules so a clean
# install does not re-download ~90MB. Relative paths resolve from backend/.
MODEL_CACHE_DIR=../.models-cache

# ─── Chat LLM ──────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
CHAT_MODEL=gemini-2.5-flash

# ─── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── Retrieval ─────────────────────────────────────────────────────────────
VECTOR_INDEX_NAME=vector_index
VECTOR_PATH=embeddingVector
VECTOR_TOP_K=5
VECTOR_NUM_CANDIDATES=150

# ─── Uploads ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=25
